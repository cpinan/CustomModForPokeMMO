<?xml version="1.0" encoding="UTF-8"?>
<!--
  Widget overrides. Included LATE, after main-widgets.xml and the stock ui/
  files, because widget themes are last wins. That is the opposite of the art
  rule, where an atlas has to be declared BEFORE anything consumes it.

  logingui is the login screen's root container. Stock gives it no background
  param at all, which is why the client's 3D scene shows through, and why the
  backdrop looked unreachable: the logo widget was the wrong place to look.
  PARAGON does exactly this in its android.xml, which is the proof it works.
-->
<themes>
    <theme name="logingui">
        <param name="background"><image>firered-login.background</image></param>
    </theme>

    <!-- Bag: the item square becomes the white FireRed box, which already
         carries a selected state from the box/box-on roles. The list panel,
         pocket tabs and open-pocket underline are art-level: the bag-list role
         and the paint_bag_tab painter in build_firered_atlas.py. Re-declaring
         a theme MERGES into stock (settled 2026-08-30), so the stock font,
         border and alignment params survive this block. -->
    <theme name="inventory-button" ref="-defaults" allowWildcard="true">
        <param name="background"><image>ui-box.background</image></param>
    </theme>
</themes>

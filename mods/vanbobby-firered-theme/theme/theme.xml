<?xml version="1.0" encoding="UTF-8"?>
<!--
  FireRed, the desktop theme. is_mobile="false".

  Every stock file is pulled in by ABSOLUTE client path, not vendored. The skill
  guidance is to copy data/themes/default/ into the mod and rewrite the
  "../default/" includes; that is 47 MB and it freezes the mod against one client
  build. vanbobby-android-layout-fix already proved the absolute form works, so
  this theme carries only the art it actually repaints, and picks up client
  updates to everything else for free.

  Include order IS the cascade. There is no specificity in TWL, later simply
  wins, so every override lives at the bottom, after the stock list.

  pmtheme.py check reports every absolute include as unresolved. That is the
  checker being archive relative; it has no notion of the client path form.
-->
<themes>
	<constantDef name="main-theme-color"><color>#6a889b</color></constantDef>
	<constantDef name="main-color"><color>#5db1ff</color></constantDef>
	<constantDef name="sub-color"><color>#5db1ff</color></constantDef>
	<constantDef name="tooltip-tint"><color>#FF565D63</color></constantDef>

<include filename="../firered/fonts-desktop.xml"/>
	<!-- Must be included after all fonts are loaded -->
	<fontGen/>
	
	<include filename="/data/themes/default/cursors.xml"/>
	<include filename="/data/themes/default/gfx.xml"/>
	<include filename="/data/themes/default/gfx_ui.xml"/>
	<!-- ===== FireRed art overrides =====
	     These sit BEFORE init.xml and main-widgets.xml on purpose. TWL resolves an
	     <image> reference when the widget theme naming it is parsed, so an atlas
	     redefined after main-widgets.xml is simply too late: the widget already
	     holds the stock image object. Include order is the cascade for widget
	     themes, but for images the rule is "declare before first use". -->
	<include filename="../firered/overrides.xml"/>

	<include filename="/data/themes/default/init.xml"/>
	
	<!-- Including rest of the GUI -->
	<include filename="/data/themes/default/ui/main.xml"/>
	<include filename="/data/themes/default/ui/battle.xml"/>
	<include filename="/data/themes/default/ui/contest.xml"/>
	<include filename="/data/themes/default/ui/party.xml"/>
	<include filename="/data/themes/default/ui/inventory.xml"/>
	<include filename="/data/themes/default/ui/chat.xml"/>
	<include filename="/data/themes/default/ui/monster-dex.xml"/>
	<include filename="/data/themes/default/ui/monster-frame.xml"/>
	<include filename="/data/themes/default/ui/customization.xml"/>
	<include filename="/data/themes/default/ui/settings.xml"/>
	<include filename="/data/themes/default/ui/guild.xml"/>
	<include filename="/data/themes/default/ui/matchmaking.xml"/>
	<include filename="/data/themes/default/ui/social.xml"/>
	<include filename="/data/themes/default/ui/instance.xml"/>
	<include filename="/data/themes/default/ui/tt.xml"/>
	<include filename="/data/themes/default/ui/trade.xml"/>
	<include filename="/data/themes/default/ui/shop.xml"/>
	<include filename="/data/themes/default/ui/link.xml"/>
	<include filename="/data/themes/default/ui/misc.xml"/>
	<include filename="/data/themes/default/ui/advanced-search.xml"/>
	<include filename="/data/themes/default/ui/broker.xml"/>
  <include filename="/data/themes/default/ui/pc.xml"/>
  <include filename="/data/themes/default/ui/incubator.xml"/>
	<include filename="/data/themes/default/ui/staff.xml"/>
	<include filename="/data/themes/default/main-widgets.xml"/></themes>

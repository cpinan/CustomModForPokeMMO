# Never commit game ROMs — they are copyrighted and belong nowhere near a repo
*.gba
*.nds
*.3ds
roms/

# OS / editor noise
.DS_Store
._*
Thumbs.db
desktop.ini
.idea/
.vscode/
__pycache__/

# Client logs pulled off a device (may contain account details)
device-logs*/
*.logcat
logcat-*.txt
previews/

# The client's own string dumps: ~166,000 entries of the game's text. The mod is
# generated from YOUR install's dumps so that nobody redistributes them -- that
# is the whole design. Produce them with Settings > Utilities.
strings-work/dumps/
strings-work/dumps

# Someone else's mods, kept locally as a reference to measure against
MODEXAMPLES/
MODEXAMPLES

# A stray copy of a client install that lives beside the toolkit on one machine
modkit/src/pmmod/log/
modkit/src/pmmod/config/

# theme-iterate.sh writes every build here, so dist/ fills with superseded
# archives -- 26 of them was 35 MB that git could never have shed again. Only
# the released version is committed, and dist/ is pruned to one artifact per mod.
# BUMP THE EXCEPTION BELOW when the theme ships a new version.
dist/vanbobby-firered-theme-0-*.mod
!dist/vanbobby-firered-theme-0-50.mod
